---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolawiForm from '../components/SolawiForm.astro';
import SolawiGauge from '../components/SolawiGauge.astro';
import PageHero from '../components/PageHero.astro';
import { anteile, formatPreis, proJahr, zahlungsarten, SAISON, LIEFERWOCHEN, ANZAHL_ERNTEANTEILE, LIEFERZEITRAUM, WIRTSCHAFTSJAHR } from '../data/anteile';
---

<BaseLayout 
  title="Solawi — Gemeinschaftsgetragene Landwirtschaft | Biosain"
  description={`Wie die Solawi bei Biosain funktioniert: Wöchentlich frisches, samenfestes Bio-Gemüse direkt vom Wachtberg nach Wien und ins Waldviertel. Jetzt Ernteanteil für ${SAISON} sichern.`}
>
  <PageHero
    image="/images/card-solawi.jpg"
    eyebrow="Gemeinschaftsgetragene Landwirtschaft"
    title="Solawi — so funktioniert es"
    lead="Eine gemeinschaftsgetragene Landwirtschaft ermöglicht Verbraucher*innen und Produzent*innen, außerhalb eines marktwirtschaftlichen Systems — das zumeist weder fair, gesund noch ökologisch tragbar ist — neu in Beziehung zu treten."
  >
    <div class="page-hero-actions">
      <a href="#anmelden" class="btn btn-gold">
        Für einen Ernteanteil anmelden ↓
      </a>
    </div>
  </PageHero>

  <!-- Jauge Quota Solawi -->
  <section class="container container-narrow solawi-gauge-section">
    <SolawiGauge available={true} />
  </section>

  <!-- Double Colonne : Was es euch bringt & Was es uns ermöglicht -->
  <section class="section-padding impact-section">
    <div class="container">
      <div class="impact-grid">
        <!-- Spalte 1: Für euch -->
        <div class="impact-col">
          <div class="col-badge">
            <span class="badge badge-brand">Für euch</span>
          </div>
          <h2 class="col-title">Was euch ein Ernteanteil bringt</h2>
          <ul class="benefit-list">
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Frisches, vielfältiges Gemüse</strong>
                <p>Wöchentlich, regional und saisonal, geerntet zum idealen Reifezeitpunkt.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Vergessene Geschmäcker</strong>
                <p>(Wieder)entdecken seltener Aromen, samenfester Sorten und botanischer Kostbarkeiten.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Nähe und Bezug</strong>
                <p>Zu den Menschen, den Jahreszeiten und dem Wachtberger Boden, auf dem euer Gemüse wächst.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Höchste Qualität</strong>
                <p>Schonender, geschmacks- und vitalitätsorientierter Anbau in lebendigen Böden.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Sinnvolle Unterstützung</strong>
                <p>Kleinbäuerliche, regionale Biolandwirtschaft aktiv fördern und für die Zukunft sichern.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon">✓</div>
              <div>
                <strong>Neue Kochideen</strong>
                <p>Inspiration in der Küche durch die bunte, wechselnde Vielfalt der wöchentlichen Ernteanteile.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Spalte 2: Für die Farm -->
        <div class="impact-col impact-col-farm">
          <div class="col-badge">
            <span class="badge badge-forest">Für den Hof</span>
          </div>
          <h2 class="col-title">Was ihr damit ermöglicht</h2>
          <ul class="benefit-list">
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Ökologisch nachhaltiges Arbeiten</strong>
                <p>Eine regenerative, lebensbejahende und kleinstrukturierte Landwirtschaft zu erhalten.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Vielfalt statt Ertragslogik</strong>
                <p>Ein Hoforganismus, in dem auch seltene und anspruchsvolle Kulturen und Sorten ihren geschützten Platz haben.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Faire Entlohnung</strong>
                <p>Ein gesundes, faires und planbares Arbeitsumfeld für die Menschen, die das Gemüse kultivieren.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Verlässliche Planung</strong>
                <p>Sinnvolle und zukunftssichere Planung der Anbausaison und der schrittweisen Betriebsentwicklung.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Direkte Partnerschaft</strong>
                <p>Ein persönlicher Austausch mit den Menschen, die unsere Ernte tagtäglich essen und genießen.</p>
              </div>
            </li>
            <li>
              <div class="bullet-icon bullet-icon-farm"></div>
              <div>
                <strong>Gemüse in Bestform</strong>
                <p>Keine Überproduktion und Ressourcenverschwendung, sondern exakt abgestimmte Erntefrische.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Das Wichtigste auf einen Blick -->
  <section class="section-padding overview-section">
    <div class="container container-narrow">
      <div class="text-center mb-8">
        <span class="eyebrow">Organisatorisches & Details</span>
        <h2>Auf einen Blick</h2>
        <p>Alle organisatorischen Rahmenbedingungen für die Saison.</p>
      </div>

      <div class="table-responsive">
        <table>
          <tbody>
            <tr>
              <th style="width: 32%;">Lieferzeitraum</th>
              <td>
                <strong>{LIEFERZEITRAUM}</strong><br>
                <span class="price-note">Der genaue Rhythmus richtet sich nach dem Pflanzenwachstum: Bei frühem Frühlingswetter starten wir schon im März und legen dafür bei Bedarf später eine Lieferpause ein. Termine kündigen wir rechtzeitig im Erntebrief an.</span>
              </td>
            </tr>
            <tr>
              <th>Lieferrhythmus</th>
              <td>Wöchentlich freitags ({LIEFERWOCHEN} Lieferwochen, insgesamt {ANZAHL_ERNTEANTEILE} Ernteanteile inkl. Doppel-Kiste zum Saisonabschluss)</td>
            </tr>
            <tr>
              <th>Wirtschaftsjahr</th>
              <td>{WIRTSCHAFTSJAHR}</td>
            </tr>
            <tr>
              <th>Solidarischer Beitrag</th>
              <td>
                <p class="price-intro">Ihr wählt euren Beitrag selbst: den <strong>Basisbeitrag</strong> (kostendeckend), den <strong>Richtwert / Förderbeitrag</strong> (ermöglicht die Weiterentwicklung des Betriebs) oder einen individuellen Monatsbeitrag — mindestens in Höhe des Basisbeitrags eurer gewählten Größe.</p>
                <ul class="price-list">
                  {anteile.map((a) => (
                    <li>
                      <strong>{a.label}</strong> <span class="price-note">({a.personen})</span>
                      <div class="price-tiers">
                        <span>Basis: <span class="price-highlight">{formatPreis(a.basis)}</span>/Monat <span class="price-note">({formatPreis(proJahr(a.basis))}/Jahr)</span></span>
                        <span>Richtwert: <span class="price-highlight">{formatPreis(a.richtwert)}</span>/Monat <span class="price-note">({formatPreis(proJahr(a.richtwert))}/Jahr)</span></span>
                      </div>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
            <tr>
              <th>Zahlung</th>
              <td>
                <ul class="price-list">
                  {zahlungsarten.map((z) => <li>{z}</li>)}
                </ul>
              </td>
            </tr>
            <tr>
              <th>Abholung Wien<br><small style="font-weight: normal; color: var(--color-ink-soft);">(jeden Freitag)</small></th>
              <td>
                <ul class="pickup-list">
                  <li><strong>1040 Wien:</strong> Reformhaus Wallner</li>
                  <li><strong>1020 Wien:</strong> Ihana, Foodcoop Stadtgut, Wins, Salon im Park</li>
                  <li><strong>1150 Wien:</strong> Foodcoops d'Speis, Allmunde, Vegan Foodcoop <em>(nur als Foodcoop-Mitglied möglich)</em></li>
                  <li><strong>1070 Wien:</strong> Sauerkraut</li>
                </ul>
              </td>
            </tr>
            <tr>
              <th>Abholung Waldviertel</th>
              <td>
                <strong>Ab Hof</strong> (Am Wachtberg 78, 3571 Gars/Thunau) und <strong>Working Space Gars am Kamp</strong>.
              </td>
            </tr>
            <tr>
              <th>Neuer Standort?</th>
              <td>Ab 15 Ernteteiler*innen können wir gerne eine neue Verteilstelle in Wien einrichten. Sprecht uns an!</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="section-padding faq-section">
    <div class="container container-narrow">
      <div class="text-center mb-8">
        <h2>Häufige Fragen (FAQ)</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-question">
            <span>Was ist in einem Ernteanteil enthalten?</span>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Ein Ernteanteil enthält eine bunte, reichhaltige Auswahl an saisonalem Gemüse — über 60 verschiedene Kulturen im Laufe des Jahres. Im Frühling startet die Saison mit frischen Salaten, Kräutern, Radieschen und Spinat. Im Sommer folgen saftige Paradeiser, Paprika, Zucchini, Gurken und Bohnen. Im Herbst und Frühwinter runden Kürbisse, Wurzelgemüse, Kohlsorten und Wintersalate das Paket ab.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Welche Ernteanteilgröße ist die richtige für mich?</span>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              <strong>Der kleine Ernteanteil</strong> ist der richtige für dich, wenn du alleine lebst, Gemüse liebst, aber nicht täglich kochst.
            </p>
            <p>
              <strong>Der ganze Ernteanteil</strong> ist der richtige für dich, wenn du entweder alleine lebst, aber gerne und viel mit Gemüse kochst, oder wenn ihr eine Kleinfamilie, WG oder zu zweit seid, aber nicht täglich die Muße zum Kochen habt.
            </p>
            <p>
              <strong>Ein großer Ernteanteil</strong> passt zu euch, wenn ihr eine Gemüsetiger-Familie seid, die täglich für mehrere Menschen kocht, die Gemüse lieben.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Wie läuft die wöchentliche Abholung ab?</span>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Jeden Freitag stehen eure frischen Ernteanteile an den jeweiligen Wiener oder Waldviertler Abholstandorten zur Selbstabholung bereit. Solltet ihr im Urlaub oder verhindert sein, kann jederzeit eine befreundete Person, Nachbar*in oder Familie euren Anteil für euch abholen.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Wie kann ich mich verbindlich anmelden?</span>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Füllt einfach die Solawi-Vereinbarung unten aus — damit meldet ihr euch verbindlich für die Saison {SAISON} an. Sollten alle Ernteanteile belegt sein, erhaltet ihr automatisch einen Platz auf unserer Warteliste. Fragen vorab? Schreibt uns gern an <strong>office.biosain@gmail.com</strong>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Formulaire d'inscription / contact -->
  <section class="section-padding form-section" id="anmelden">
    <div class="container">
      <SolawiForm />
    </div>
  </section>
</BaseLayout>

<style>
  .solawi-gauge-section {
    margin-top: -2rem;
    position: relative;
    z-index: 5;
  }

  /* Impact section */
  .impact-section {
    background-color: var(--color-surface);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .impact-col {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-sm);
  }

  .col-title {
    font-size: 1.5rem;
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .benefit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .benefit-list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .bullet-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-sunken);
    color: var(--color-brand-primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .bullet-icon-farm {
    background-color: var(--badge-accent-bg);
    color: var(--color-brand-secondary);
    font-size: 0.85rem;
  }

  .benefit-list strong {
    display: block;
    color: var(--color-ink);
    margin-bottom: 2px;
  }

  .benefit-list p {
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Overview section */
  .overview-section {
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .mb-8 {
    margin-bottom: var(--space-8);
  }

  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .price-list {
    gap: var(--space-3);
  }

  .price-intro {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-3);
  }

  .price-tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .price-highlight {
    font-size: 1.05rem;
    font-weight: var(--weight-bold);
    color: var(--color-brand-secondary-dark);
  }

  .price-note {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .pickup-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.9rem;
  }

  /* FAQ */
  .faq-section {
    background-color: var(--color-surface);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-brand-primary);
  }

  .faq-question {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: 1.05rem;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.3rem;
    color: var(--color-brand-secondary);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* Form section */
  .form-section {
    background: var(--color-surface-sunken);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 860px) {
    .impact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
