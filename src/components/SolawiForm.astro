---
const GOOGLE_FORM_ID = "1FAIpQLScg3tqrPztv4zzMBjEelP9KwBUklGPIYGL4Og-mYGFv9zGilA";
const googleFormEmbedUrl = `https://docs.google.com/forms/d/e/${GOOGLE_FORM_ID}/viewform?embedded=true`;
---

<div class="solawi-form-wrapper" id="anmelden">
  <div class="form-card">
    <div class="form-header">
      <span class="eyebrow">Gemeinschaftsgetragene Landwirtschaft</span>
      <h2 class="form-title">Interesse an einem Ernteanteil?</h2>
      <p class="form-subtitle">
        Meldet euch bei uns — wir antworten innerhalb weniger Tage mit allen Details zur Saison.
      </p>
    </div>

    <div class="google-form-container">
      <iframe
        src={googleFormEmbedUrl}
        width="100%"
        height="1500"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Biosain – Ernteanteil-Anmeldung 2026"
      >Formular wird geladen…</iframe>
    </div>
  </div>
</div>

<style>
  .solawi-form-wrapper {
    padding-top: var(--space-8);
  }

  .form-card {
    background-color: var(--color-surface-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    max-width: 860px;
    margin: 0 auto;
  }

  .form-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto var(--space-8);
  }

  .form-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .form-subtitle {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .google-form-container {
    margin: 0 -1rem;
  }

  .google-form-container iframe {
    display: block;
    border: none;
  }
</style>
