---
import { events } from '../data/termine';
---

<div class="event-filter-component" id="events-section">
  <!-- Filter Tabs -->
  <div class="filter-bar" role="tablist" aria-label="Veranstaltungskategorien">
    <button type="button" class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
      Alle ({events.length})
    </button>
    <button type="button" class="filter-btn" data-filter="maerkte" role="tab" aria-selected="false">
      Märkte
    </button>
    <button type="button" class="filter-btn" data-filter="workshops" role="tab" aria-selected="false">
      Workshops
    </button>
    <button type="button" class="filter-btn" data-filter="kunst" role="tab" aria-selected="false">
      Kunst in der Natur
    </button>
    <button type="button" class="filter-btn" data-filter="jobs" role="tab" aria-selected="false">
      Praktika & Jobs
    </button>
  </div>

  <!-- Events List Table / Cards -->
  <div class="table-responsive">
    <table class="events-table">
      <thead>
        <tr>
          <th>Datum</th>
          <th>Veranstaltung</th>
          <th>Uhrzeit</th>
          <th>Ort</th>
          <th>Kategorie</th>
          <th>Aktion</th>
        </tr>
      </thead>
      <tbody>
        {events.map((event) => (
          <tr class="event-row" data-category={event.category} data-end-date={event.endDate}>
            <td class="event-date" data-label="Datum">
              <strong>{event.date}</strong>
            </td>
            <td class="event-name" data-label="Veranstaltung">
              <span class="event-title">{event.title}</span>
            </td>
            <td class="event-time" data-label="Uhrzeit">{event.time}</td>
            <td class="event-location" data-label="Ort">{event.location}</td>
            <td data-label="Kategorie">
              <span class:list={["badge", event.category === 'maerkte' ? 'badge-brand' : 'badge-forest']}>
                {event.categoryLabel}
              </span>
            </td>
            <td class="event-action" data-label="Aktion">
              {event.infoLink && (
                <a href={event.infoLink} class="btn btn-secondary btn-xs" target={event.infoLink.startsWith('http') ? '_blank' : undefined} rel={event.infoLink.startsWith('http') ? 'noopener noreferrer' : undefined}>
                  {event.infoText || "Details"}
                </a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const eventRows = document.querySelectorAll<HTMLElement>('.event-row');

  // Masque l'action (bouton) des événements dont la date est déjà passée
  const todayISO = new Date().toISOString().slice(0, 10);
  eventRows.forEach(row => {
    const endDate = row.getAttribute('data-end-date');
    if (endDate && endDate < todayISO) {
      row.classList.add('event-past');
    }
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active class
      filterBtns.forEach(b => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.getAttribute('data-filter');

      eventRows.forEach(row => {
        if (filter === 'all' || row.getAttribute('data-category') === filter) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .event-filter-component {
    margin-top: var(--space-6);
  }

  .filter-bar {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .filter-btn {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-card);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    background: var(--color-surface-sunken);
    color: var(--color-ink);
  }

  .filter-btn.is-active {
    background: var(--color-brand-secondary);
    color: #FFFFFF;
    border-color: var(--color-brand-secondary);
  }

  .events-table {
    min-width: 720px;
  }

  .event-date {
    color: var(--color-brand-secondary-dark);
    white-space: nowrap;
  }

  .event-title {
    font-weight: var(--weight-bold);
    color: var(--color-ink);
    display: block;
  }

  .event-time, .event-location {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .btn-xs {
    padding: 0.35rem 0.85rem;
    font-size: var(--text-xs);
    border-radius: var(--radius-full);
  }

  /* Événement passé : l'action (bouton) disparaît, la ligne reste visible mais estompée */
  .event-past {
    opacity: 0.55;
  }

  .event-past .event-action {
    visibility: hidden;
  }

  /* Mobile : la table se transforme en liste de cartes empilées plutôt que de scroller horizontalement */
  @media (max-width: 680px) {
    .table-responsive {
      overflow-x: visible;
      background: none;
      box-shadow: none;
      border: none;
    }

    .events-table {
      min-width: 0;
    }

    .events-table thead {
      display: none;
    }

    .events-table, .events-table tbody, .events-table tr, .events-table td {
      display: block;
      width: 100%;
    }

    .events-table tr {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      margin-bottom: var(--space-4);
    }

    .events-table td {
      border-bottom: none;
      padding: var(--space-1) 0;
    }

    .events-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-ink-faint);
      margin-top: var(--space-2);
    }

    .events-table td.event-date::before {
      margin-top: 0;
    }

    .event-action {
      margin-top: var(--space-2);
    }
  }
</style>
