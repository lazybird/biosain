---
interface Props {
  text?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  text = "🌿 Jungpflanzenmarkt am Wachtberg: 25. & 26. April, 10–17 Uhr",
  ctaText = "Sortenliste ansehen →",
  ctaHref = "/jungpflanzen"
} = Astro.props;
---

<aside class="top-banner" aria-label="Ankündigung">
  <div class="container banner-inner">
    <span class="banner-text">{text}</span>
    <a href={ctaHref} class="banner-cta">{ctaText}</a>
  </div>
</aside>

<style>
  .top-banner {
    background-color: var(--color-brand-accent);
    color: var(--color-surface);
    padding: 8px 16px;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    position: relative;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    text-align: center;
  }

  .banner-text {
    color: #F2EBCF;
  }

  .banner-cta {
    color: var(--color-brand-primary-light);
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .banner-cta:hover {
    color: #FFFFFF;
  }

  @media (max-width: 600px) {
    .top-banner {
      font-size: 0.72rem;
      padding: 6px 12px;
    }
  }
</style>
