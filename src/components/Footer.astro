---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand / Address -->
    <div class="footer-col footer-about">
      <div class="footer-brand-wrap">
        <img src="/images/logo-biosain-white.png" alt="Biosain" class="footer-logo" width="150" height="34" />
      </div>
      <p class="footer-tagline">Vielfalts-Marktgärtnerei am Wachtberg</p>
      
      <address class="footer-address">
        <strong>Tristan Toé</strong><br>
        Am Wachtberg 78<br>
        3571 Gars / Thunau am Kamp<br>
        Waldviertel, Niederösterreich
      </address>

      <div class="footer-contact">
        <a href="tel:06803216521" class="contact-link">📞 0680 321 65 21</a>
        <a href="mailto:office.biosain@gmail.com" class="contact-link">✉️ office.biosain@gmail.com</a>
      </div>
    </div>

    <!-- Navigation links -->
    <div class="footer-col">
      <h4 class="footer-heading">Navigation</h4>
      <ul class="footer-links">
        <li><a href="/solawi">Gemüse & Solawi</a></li>
        <li><a href="/jungpflanzen">Bio-Jungpflanzen</a></li>
        <li><a href="/veranstaltungen">Veranstaltungen & Mitmachen</a></li>
        <li><a href="/ueber-uns">Über uns & Anfahrt</a></li>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>

    <!-- Partners & Ecosystem -->
    <div class="footer-col">
      <h4 class="footer-heading">Netzwerk & Partner</h4>
      <p class="footer-text-sm">
        Verwurzelt im Waldviertel, vernetzt mit Initiativen für Saatgutsouveränität und lebendige Böden:
      </p>
      <ul class="footer-links">
        <li>
          <a href="https://nako.bio" target="_blank" rel="noopener noreferrer">
            Nakôbio ↗ <span class="partner-desc">— Agroécologie & Sol vivant</span>
          </a>
        </li>
        <li>
          <a href="https://www.kunstindernatur.at" target="_blank" rel="noopener noreferrer">
            Kunst in der Natur ↗ <span class="partner-desc">— Kultur am Wachtberg</span>
          </a>
        </li>
      </ul>

      <div class="footer-support-box">
        <span class="footer-support-badge">❤️ Solidarität</span>
        <p class="footer-support-text">Unterstützen Sie unsere Bildungs- & Regenerationsprojekte.</p>
        <a href="https://donorbox.org/nakobio/" target="_blank" rel="noopener noreferrer" class="footer-support-btn">
          Spenden & Fördern ↗
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} Biosain. Alle Rechte vorbehalten.</p>
      <div class="footer-legal-links">
        <a href="/impressum">Impressum</a>
        <span>•</span>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-brand-accent);
    color: #E7E3CE;
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 2px solid rgba(202, 174, 0, 0.2);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-brand-wrap {
    margin-bottom: var(--space-2);
  }

  .footer-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-wordmark {
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    margin-bottom: var(--space-1);
  }

  .footer-wordmark .gold {
    color: var(--color-brand-primary-light);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-brand-primary-light);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-4);
  }

  .footer-address {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: #D6D0BC;
    margin-bottom: var(--space-4);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-link {
    color: #F5EBC0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: #FFFFFF;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    color: #D6D0BC;
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--color-brand-primary-light);
    transform: translateX(3px);
  }

  .partner-desc {
    font-size: var(--text-xs);
    color: #A8A28E;
  }

  .footer-text-sm {
    font-size: var(--text-sm);
    color: #D6D0BC;
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .footer-bottom {
    background-color: #112015;
    padding: var(--space-4) 0;
    font-size: var(--text-xs);
    color: #8C8673;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-legal-links a {
    color: #A8A28E;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-legal-links a:hover {
    color: #FFFFFF;
  }

  .footer-support-box {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(242, 213, 66, 0.25);
    border-radius: var(--radius-md);
  }

  .footer-support-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #F8E264;
    margin-bottom: var(--space-1);
  }

  .footer-support-text {
    font-size: var(--text-xs);
    color: #D6D0BC;
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .footer-support-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #CAAE00;
    color: #112015;
    font-size: 0.8rem;
    font-weight: var(--weight-bold);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .footer-support-btn:hover {
    background: #F8E264;
    transform: translateY(-1px);
    color: #112015;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
