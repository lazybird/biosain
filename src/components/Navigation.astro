---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: "/solawi", label: "Gemüse & Solawi" },
  { href: "/jungpflanzen", label: "Jungpflanzen" },
  { href: "/veranstaltungen", label: "Veranstaltungen" },
  { href: "/ueber-uns", label: "Über uns" }
];
---

<header class="header-nav" id="main-header">
  <div class="container nav-container">
    <a href="/" class="brand" aria-label="Biosain - Startseite">
      <img src="/images/logo-biosain.png" alt="Biosain" class="brand-logo" width="168" height="38" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <li>
              <a 
                href={item.href} 
                class:list={["nav-link", { active: isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <a 
        href="https://www.leetchi.com/fr/c/biosain-1768159" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="nav-donate-link"
        title="Solidarität & Projektspende für Nakôbio"
      >
        <span class="heart-icon">❤️</span> Spenden
      </a>
      <a href="/solawi#anmelden" class="btn btn-primary btn-cta">
        Ernteteiler*in werden
      </a>
      
      <!-- Mobile Menu Toggle Button -->
      <button 
        type="button" 
        class="mobile-toggle" 
        id="menu-toggle-btn"
        aria-label="Menü öffnen" 
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Overlay (sibling au header, pas enfant — fix position:fixed) -->
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

<!-- Mobile Drawer -->
<div class="mobile-drawer" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation mobile">
  <div class="mobile-drawer-inner">
    <nav aria-label="Mobile Hauptnavigation">
      <ul class="mobile-nav-list">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <li>
              <a 
                href={item.href} 
                class:list={["mobile-nav-link", { active: isActive }]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="mobile-drawer-actions">
      <a href="/solawi#anmelden" class="btn btn-primary mobile-cta-btn">
        🌿 Ernteteiler*in werden
      </a>
      <a 
        href="https://www.leetchi.com/fr/c/biosain-1768159" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-outline mobile-donate-btn"
      >
        ❤️ Spenden / Unterstützen ↗
      </a>
    </div>
  </div>
</div>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('menu-toggle-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');

    if (!toggleBtn || !mobileMenu || !overlay) return;

    // Prevent duplicate event handlers
    if (toggleBtn.dataset.menuInitialized === 'true') return;
    toggleBtn.dataset.menuInitialized = 'true';

    function openMenu() {
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.classList.add('is-active');
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.classList.remove('is-active');
      mobileMenu.classList.remove('is-open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      overlay.classList.remove('is-visible');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('is-open');
      isOpen ? closeMenu() : openMenu();
    });

    overlay.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        closeMenu();
        toggleBtn.focus();
      }
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>

<style>
  .header-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 253, 246, 0.92);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: var(--space-4);
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .brand-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: transform var(--transition-fast);
  }

  .brand:hover .brand-logo {
    transform: scale(1.02);
  }

  .brand-text {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
    color: var(--color-brand-secondary-dark);
  }

  .brand-text .gold {
    color: var(--color-brand-primary);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: var(--weight-semibold);
    color: var(--color-ink-soft);
    text-decoration: none;
    padding: 0.4rem 0.2rem;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-brand-primary);
    transition: width var(--transition-base);
  }

  .nav-link:hover {
    color: var(--color-brand-secondary-dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--color-brand-secondary-dark);
    font-weight: var(--weight-bold);
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-cta {
    font-size: 0.85rem;
    padding: 0.6rem 1.3rem;
  }

  .nav-donate-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: var(--weight-bold);
    color: var(--color-ink-soft);
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    transition: all var(--transition-fast);
  }

  .nav-donate-link:hover {
    color: #9333ea;
    border-color: #f43f5e;
    background-color: #fff1f2;
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .nav-donate-link .heart-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    cursor: pointer;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle:hover {
    background-color: var(--color-surface-sunken);
  }

  .mobile-toggle .icon-close {
    display: none;
  }

  .mobile-toggle.is-active .icon-open {
    display: none;
  }

  .mobile-toggle.is-active .icon-close {
    display: block;
  }

  /* Mobile Overlay */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 20, 12, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 55;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }

  .mobile-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--color-surface);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    padding-top: 80px; /* hauteur du header */
    transform: translateY(-110%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-drawer.is-open {
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer-inner {
    padding: var(--space-4) var(--space-5) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-size: 1.15rem;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background-color: var(--color-surface-sunken);
    color: var(--color-brand-secondary-dark);
  }

  .mobile-nav-link.active {
    color: var(--color-brand-primary-dark);
    font-weight: var(--weight-bold);
    background-color: rgba(var(--color-brand-primary-rgb, 167, 145, 48), 0.12);
  }

  .mobile-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .mobile-cta-btn {
    width: 100%;
    text-align: center;
    min-height: 52px;
    font-size: 1rem;
    touch-action: manipulation;
  }

  .mobile-donate-btn {
    width: 100%;
    text-align: center;
    min-height: 52px;
    font-size: 0.95rem;
    border-color: var(--color-brand-primary);
    color: var(--color-ink);
    touch-action: manipulation;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .btn-cta,
    .nav-donate-link {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .mobile-overlay {
      display: block;
    }
  }
</style>
