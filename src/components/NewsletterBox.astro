---
interface Props {
  variant?: 'card' | 'section';
}

const { variant = 'section' } = Astro.props;

// Les valeurs doivent correspondre exactement au Google Form « Biosain – Newsletter »
const FORM_ACTION = "https://docs.google.com/forms/d/e/1FAIpQLSeEtYkwzCLQhtj8B9boYdLJLyEgylSllpqLigYH4yzuYOMBZg/formResponse";
const ENTRY_EMAIL = "entry.1580382414";
const ENTRY_EINWILLIGUNG = "entry.715833628";
const EINWILLIGUNG_TEXT = "Ich möchte den Biosain-Newsletter per E-Mail erhalten. Abmeldung jederzeit möglich. Details: https://biosain.at/datenschutz";
---

<section class:list={["newsletter-block", { "newsletter-standalone": variant === 'section' }]} id="newsletter">
  <div class="newsletter-card">
    <div class="newsletter-decor" aria-hidden="true"></div>
    
    <div class="newsletter-content">
      <span class="eyebrow">Auf dem Laufenden bleiben</span>
      <h2 class="newsletter-title">Neuigkeiten vom Wachtberg</h2>
      <p class="newsletter-text">
        1-2 Mal im Monat: Geschichten vom Hof, Saisonrezepte, Markttermine und Ankündigungen zu Workshops — direkt in euer Postfach.
      </p>

      <form class="newsletter-form" action={FORM_ACTION} method="POST" data-newsletter-form>
        <div class="input-wrap">
          <input
            type="email"
            name={ENTRY_EMAIL}
            placeholder="Deine E-Mail-Adresse"
            required
            class="newsletter-input"
            aria-label="E-Mail-Adresse für den Newsletter"
          />
          <button type="submit" class="btn btn-gold btn-newsletter">
            Anmelden
          </button>
        </div>
        <label class="newsletter-consent">
          <input type="checkbox" name={ENTRY_EINWILLIGUNG} value={EINWILLIGUNG_TEXT} required />
          <span>
            Ich möchte den Biosain-Newsletter per E-Mail erhalten. Abmeldung jederzeit möglich.
            <a href="/datenschutz">Datenschutz</a>
          </span>
        </label>
        <input type="text" name="website" class="newsletter-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="newsletter-disclaimer">
          Kein Spam. Abmelden könnt ihr euch jederzeit per E-Mail an office.biosain@gmail.com.
        </p>
      </form>
      <div class="newsletter-success" role="status" aria-live="polite" tabindex="-1" hidden>
        <span class="success-icon" aria-hidden="true">✓</span>
        <div>
          <p class="success-title">Vielen Dank für deine Anmeldung!</p>
          <p class="success-text">
            Du erhältst ab jetzt unseren Newsletter mit Neuigkeiten vom Wachtberg. Abmelden kannst du dich jederzeit per E-Mail an office.biosain@gmail.com.
          </p>
        </div>
      </div>
      <p class="newsletter-error" role="alert" hidden>
        Das hat leider nicht geklappt. Bitte versuche es später noch einmal oder schreib uns an office.biosain@gmail.com.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    const success = form.parentElement?.querySelector<HTMLElement>('.newsletter-success');
    const error = form.parentElement?.querySelector<HTMLElement>('.newsletter-error');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get('website')) return; // piège à robots rempli
      data.delete('website');

      if (button) {
        button.disabled = true;
        button.textContent = 'Wird gesendet…';
      }
      if (error) error.hidden = true;
      try {
        // Google n'autorise pas la lecture de sa réponse : en no-cors, une requête partie = succès supposé
        await fetch(form.action, { method: 'POST', mode: 'no-cors', body: data });
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
          success.focus({ preventScroll: true });
        }
      } catch {
        if (error) error.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = 'Anmelden';
        }
      }
    });
  });
</script>

<style>
  .newsletter-consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-size: var(--text-sm);
    color: #D6D0BC;
    margin-bottom: var(--space-3);
    cursor: pointer;
  }

  .newsletter-consent input {
    margin-top: 0.2rem;
    accent-color: var(--color-brand-primary);
  }

  .newsletter-consent a {
    color: #F2D542;
  }

  .newsletter-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .newsletter-success:not([hidden]) {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: rgba(255, 253, 246, 0.08);
    border: 1px solid rgba(242, 213, 66, 0.45);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    outline: none;
    animation: success-in 0.35s ease-out;
  }

  .success-icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: #F2D542;
    color: #1E3324;
    font-weight: var(--weight-bold);
    font-size: 1.15rem;
    display: grid;
    place-items: center;
  }

  .success-title {
    color: #FFFFFF;
    font-size: 1.15rem;
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-1);
  }

  .success-text {
    color: #D6D0BC;
    font-size: var(--text-sm);
    margin: 0;
  }

  .newsletter-error {
    color: #FFB4A8;
    font-size: var(--text-sm);
    margin: var(--space-3) 0 0;
  }

  .btn-newsletter:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  @keyframes success-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
</style>

<style>
  .newsletter-block {
    position: relative;
  }

  .newsletter-standalone {
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .newsletter-card {
    background: linear-gradient(135deg, #2F4A34 0%, #1E3324 100%);
    color: #FFFDF6;
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 5vw, 3.5rem);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(202, 174, 0, 0.25);
  }

  .newsletter-decor {
    position: absolute;
    right: -20px;
    bottom: -30px;
    font-size: clamp(8rem, 15vw, 12rem);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }

  .newsletter-content {
    max-width: 640px;
    position: relative;
    z-index: 2;
  }

  .newsletter-card .eyebrow {
    color: var(--color-brand-primary-light);
  }

  .newsletter-title {
    color: #FFFFFF;
    margin-bottom: var(--space-3);
  }

  .newsletter-text {
    color: #D6D0BC;
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .newsletter-form {
    width: 100%;
  }

  .input-wrap {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .newsletter-input {
    flex: 1;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 253, 246, 0.95);
    color: var(--color-ink);
    transition: all var(--transition-fast);
  }

  .newsletter-input:focus {
    outline: none;
    background: #FFFFFF;
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 0 3px rgba(202, 174, 0, 0.3);
  }

  .btn-newsletter {
    padding: 0.85rem 1.8rem;
    font-size: 0.95rem;
  }

  .newsletter-disclaimer {
    font-size: var(--text-xs);
    color: #A8A28E;
    margin: 0;
  }

  @media (max-width: 640px) {
    .input-wrap {
      flex-direction: column;
    }

    .btn-newsletter {
      width: 100%;
    }
  }
</style>
