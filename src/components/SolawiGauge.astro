---
interface Props {
  available?: boolean;
  seasonYear?: number;
}

const {
  available = true,
  seasonYear = 2026
} = Astro.props;
---

<div class:list={["solawi-gauge", { "is-full": !available }]}>
  <div class="gauge-header">
    <div class="gauge-title-group">
      <span class="badge badge-brand">Saison {seasonYear}</span>
      <strong class="gauge-title">
        {available ? "Ernteteilen — Anmeldung läuft" : "Ernteteilen — Saison ausgebucht"}
      </strong>
    </div>
    <div class="gauge-status">
      <span class="status-dot" aria-hidden="true"></span>
      {available ? "Plätze frei" : "Ausgebucht"}
    </div>
  </div>

  <div class="gauge-footer">
    <p class="gauge-note">
      {available
        ? "Es sind noch Ernteanteile für die kommende Saison verfügbar."
        : "Für diese Saison sind alle Ernteanteile vergeben."}
    </p>
    {available && (
      <a href="/solawi#anmelden" class="btn btn-primary btn-sm">
        Jetzt Platz sichern →
      </a>
    )}
  </div>
</div>

<style>
  .solawi-gauge {
    background: var(--color-surface-sunken);
    border: 1px solid rgba(27, 35, 24, 0.1);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }

  .gauge-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .gauge-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .gauge-title {
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .gauge-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-brand-secondary-dark);
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background-color: var(--color-brand-secondary);
  }

  .is-full .gauge-status {
    color: var(--color-ink-soft);
  }

  .is-full .status-dot {
    background-color: var(--color-ink-faint);
  }

  .gauge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .gauge-note {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin: 0;
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .gauge-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
